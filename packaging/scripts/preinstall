#!/bin/sh
set -eu
LABEL=local.pptpclient.helper
PLIST=/Library/LaunchDaemons/local.pptpclient.helper.plist
if [ -f "$PLIST" ]; then
    PID=$(/bin/launchctl print "system/$LABEL" 2>/dev/null | /usr/bin/awk '/pid = / { print $3; exit }' || true)
    /bin/launchctl bootout "system/$LABEL" 2>/dev/null || true
    if [ -n "$PID" ]; then
        COUNT=0
        while /bin/kill -0 "$PID" 2>/dev/null; do
            COUNT=$((COUNT + 1))
            if [ "$COUNT" -gt 25 ]; then
                echo 'Previous PPTP helper is still stopping. Quit PPTPClient and retry installation.' >&2
                exit 1
            fi
            /bin/sleep 1
        done
    fi
fi
exit 0
